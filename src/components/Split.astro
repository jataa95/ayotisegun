---
// Splits text into masked letters that rise in one after another (see .split in global.css).
interface Props {
  text: string;
  as?: 'h1' | 'h2' | 'p' | 'span';
  class?: string;
  delay?: number;
}
const { text, as: Tag = 'h1', class: className, delay = 0 } = Astro.props;
let n = 0;
const words = text.split(' ').map((w) => [...w].map((ch) => ({ ch, i: n++ })));
---

<Tag class:list={['split', className]} aria-label={text} style={`--d:${delay}s`}>
  {
    words.map((letters, wi) => (
      <>
        <span class="w" aria-hidden="true">
          {letters.map(({ ch, i }) => (
            <span class="c" style={`--i:${i}`}>{ch}</span>
          ))}
        </span>
        {wi < words.length - 1 && ' '}
      </>
    ))
  }
</Tag>
