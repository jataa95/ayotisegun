---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Split from '../../components/Split.astro';
import Base from '../../layouts/Base.astro';
import { site, statusLabel } from '../../site';

export async function getStaticPaths() {
  const works = (await getCollection('works')).sort((a, b) => a.data.order - b.data.order);
  return works.map((work, i) => ({
    params: { slug: work.id },
    props: { work, index: i + 1, others: works.filter((w) => w.id !== work.id).slice(0, 2) },
  }));
}

interface Props {
  work: CollectionEntry<'works'>;
  index: number;
  others: CollectionEntry<'works'>[];
}

const { work, index, others } = Astro.props;
const { title, year, medium, theme, dimensions, image, alt, details, status, statement } = work.data;
const { Content } = await render(work);
const enquiry = `Hello Ayotisegun, I'm interested in "${title}" (${year}). Is it available?`;
const enquireHref = site.whatsapp
  ? `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(enquiry)}`
  : site.email
    ? `mailto:${site.email}?subject=${encodeURIComponent(`Enquiry: ${title}`)}&body=${encodeURIComponent(enquiry)}`
    : site.instagram;
const meta = [
  { k: 'Medium', v: medium },
  theme && { k: 'Theme', v: theme },
  dimensions && { k: 'Size', v: dimensions },
  { k: 'Year', v: String(year) },
  { k: 'Status', v: statusLabel[status] },
].filter(Boolean) as { k: string; v: string }[];
---

<Base title={title} description={statement ?? `${title} (${year}), ${medium} by ${site.fullName}.`} image={image.src}>
  <section class="cover">
    <Image src={image} alt="" widths={[800, 1400, 2000]} sizes="100vw" loading="eager" class="cover-img" />
    <div class="cover-text">
      <Split text={title} class="display" />
      <p class="small fade-in" style="--d:0.6s">Index No. {index}</p>
    </div>
  </section>

  <section class="wrap intro">
    {statement && <p class="headline">{statement}</p>}
    <dl class="meta">
      {
        meta.map((m) => (
          <div>
            <dt class="label">{m.k}</dt>
            <dd>{m.v}</dd>
          </div>
        ))
      }
      <div>
        <dt class="label">Enquire</dt>
        <dd><a href={enquireHref} target="_blank" rel="noopener" class="enquire">Ask about this work ↗</a></dd>
      </div>
    </dl>
  </section>

  <section class="wrap">
    <div class="panel full unveil">
      <Image src={image} alt={alt} widths={[600, 1000, 1500]} sizes="(min-width: 900px) 45vw, 90vw" />
    </div>
  </section>

  {
    details.length > 0 && (
      <section class:list={['wrap details', { single: details.length === 1 }]}>
        {details.map((d, i) => (
          <Image
            src={d.image}
            alt={d.alt}
            widths={[500, 900]}
            sizes="(min-width: 800px) 33vw, 100vw"
            class:list={['reveal', { lower: i % 2 === 1 }]}
          />
        ))}
      </section>
    )
  }

  <section class="wrap about-work labelled">
    <p class="label">About the painting</p>
    <div class="body"><Content /></div>
  </section>

  {
    others.length > 0 && (
      <section class="wrap more">
        <div class="more-head small">
          <span class="label">More works</span>
          <a href="/work" class="link">All work</a>
        </div>
        <div class="more-grid">
          {others.map((o) => (
            <a href={`/work/${o.id}`} data-cursor="view">
              <Image src={o.data.image} alt={o.data.alt} widths={[500, 900]} sizes="(min-width: 700px) 50vw, 100vw" />
              <div class="more-caption small">
                <span>{o.data.title}</span>
                <span class="muted">{o.data.theme}</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )
  }
</Base>

<style>
  .cover {
    position: relative;
    height: 75svh;
    min-height: 420px;
    overflow: hidden;
    background: var(--ink);
  }
  .cover :global(.cover-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    opacity: 0.85;
  }
  .cover-text {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    color: #fff;
    text-align: center;
    padding: 0 var(--gutter);
    text-shadow: 0 2px 30px rgba(0, 0, 0, 0.35);
  }
  .cover-text h1 {
    font-size: clamp(56px, 9vw, 150px);
  }
  .cover-text p {
    text-transform: uppercase;
    font-weight: 500;
  }

  .intro {
    padding-top: clamp(48px, 6vw, 88px);
    padding-bottom: clamp(48px, 6vw, 88px);
  }
  .intro .headline {
    max-width: 30ch;
    margin-bottom: clamp(32px, 4vw, 56px);
  }
  .meta {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px var(--gutter);
    border-top: 1px solid var(--line);
    padding-top: 16px;
    margin: 0;
  }
  @media (min-width: 800px) {
    .meta {
      grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    }
  }
  dd {
    margin: 4px 0 0;
    font-size: 13px;
    font-weight: 500;
  }
  .enquire:hover {
    color: var(--accent);
  }

  .full {
    padding: clamp(32px, 6vw, 72px) var(--gutter);
  }
  .full :global(img) {
    max-height: 82vh;
    width: auto;
  }

  .details {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
    padding-top: 12px;
  }
  @media (min-width: 800px) {
    .details {
      grid-template-columns: 1fr 1fr;
      max-width: 72%;
      margin: 0 auto;
      align-items: start;
    }
    .details :global(.lower) {
      margin-top: 72px;
    }
    .details.single {
      grid-template-columns: 1fr;
      max-width: 40%;
    }
  }
  .details :global(img) {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }

  .about-work {
    padding-top: clamp(64px, 8vw, 120px);
    padding-bottom: clamp(64px, 8vw, 120px);
  }
  @media (min-width: 900px) {
    .about-work {
      grid-template-columns: 1fr 1fr;
    }
  }
  .body {
    max-width: 56ch;
    font-size: 15px;
  }

  .more {
    padding-bottom: clamp(64px, 8vw, 120px);
  }
  .more-head {
    display: flex;
    justify-content: space-between;
    margin-bottom: 16px;
  }
  .more-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px var(--gutter);
  }
  @media (min-width: 700px) {
    .more-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .more-grid :global(img) {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }
  .more-caption {
    display: flex;
    justify-content: space-between;
    margin-top: 10px;
    font-weight: 500;
  }
</style>
