---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Split from '../components/Split.astro';
import Marquee from '../components/Marquee.astro';
import { steps } from '../data';
import { site } from '../site';
import hero from '../assets/works/riders-dusk-2026-signature.jpg';
import kinds1 from '../assets/tiles/street-figure.jpg';
import kinds2 from '../assets/tiles/dusk-heads.jpg';
import kinds3 from '../assets/tiles/grey-heads.jpg';
import kinds4 from '../assets/tiles/street-roof.jpg';

const kinds = [
  { title: 'Portraits & people', text: 'A loved one, a family, children at play, painted with the warmth and texture of a lived moment.', img: kinds2 },
  { title: 'Places & streets', text: 'The street you grew up on, a market, a city view. The places that hold your stories.', img: kinds1 },
  { title: 'Movement & culture', text: 'Riders, festivals and gatherings: scenes full of motion, colour and ceremony.', img: kinds3 },
  { title: 'Statement pieces', text: 'Large works made for a home, office, hotel lobby or brand space, sized to the wall.', img: kinds4 },
];

const faqs = [
  {
    q: 'Can you paint from my photos?',
    a: 'Yes. Most commissions start from a few photos plus a conversation about the feeling you want. The painting interprets the photo rather than copying it, which is where the impasto comes alive.',
  },
  {
    q: 'How much does a commission cost?',
    a: 'Pricing depends mainly on size and how complex the scene is. After the first conversation you receive a clear quote, and nothing starts until you are happy with it.',
  },
  {
    q: 'How long does it take?',
    a: 'Thick impasto takes longer to dry than ordinary paint, so allow several weeks from the agreed sketch to delivery. The exact timeline is set together before work begins.',
  },
  {
    q: 'Do you deliver outside my city?',
    a: 'Yes. Commissions are open nationwide, and finished paintings are packed and delivered anywhere in Nigeria. For international enquiries, get in touch.',
  },
  {
    q: 'Will I see the painting before it is finished?',
    a: 'Yes. You approve the composition at the study stage and receive progress updates while it is being painted.',
  },
  {
    q: 'Can I buy an existing painting instead?',
    a: 'Of course. Available works are marked on the Work page. Use "Ask about this work" on any painting to check availability.',
  },
];
---

<Base title="Commissions" description="Commission an original impasto painting by Ayotisegun. Portraits, places and statement pieces, delivered nationwide.">
  <header class="wrap page-title">
    <p class="label fade-in" style="--d:0.1s">(Open nationwide)</p>
    <Split text="Commissions" class="display long-title" />
    <p class="headline fade-in">An original painting made for you, built up thick with the palette knife.</p>
  </header>

  <section class="wrap lead">
    <div class="lead-img unveil">
      <Image src={hero} alt="Close-up of a finished impasto canvas with ridged peach and violet paint and the artist's signature." widths={[600, 1000, 1400]} sizes="(min-width: 900px) 50vw, 100vw" loading="eager" />
    </div>
    <div class="lead-text">
      <p class="headline">Your story, in paint you can feel.</p>
      <p>
        A commission is a collaboration. You bring the person, place or moment; Ayotisegun brings it to life in heavy,
        sculpted layers of oil paint that catch the light differently through the day.
      </p>
      <a href="/contact" class="button-dark">Start a commission →</a>
    </div>
  </section>

  <section class="wrap kinds">
    <p class="label">(What you can commission)</p>
    <ul>
      {
        kinds.map((k, i) => (
          <li class="reveal">
            <span class="label">{String(i + 1).padStart(2, '0')}</span>
            <h2>{k.title}</h2>
            <p class="muted">{k.text}</p>
            <Image src={k.img} alt="" widths={[300, 500]} sizes="(min-width: 900px) 12vw, 30vw" class="kind-img" />
          </li>
        ))
      }
    </ul>
  </section>

  <section class="process dark wrap">
    <div class="labelled">
      <p class="label">(How it works)</p>
      <h2 class="display process-title">From a story to the canvas</h2>
    </div>
    <ol class="steps">
      {
        steps.map((s, i) => (
          <li class="reveal">
            <span class="label">{String(i + 1).padStart(2, '0')}</span>
            <h3>{s.title}</h3>
            <p class="muted">{s.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="wrap faq" id="faq">
    <div class="labelled">
      <p class="label">(Questions)</p>
      <div>
        <h2 class="display faq-title">FAQ</h2>
        <div class="faq-list">
          {
            faqs.map((f) => (
              <details>
                <summary>
                  <span>{f.q}</span>
                  <span class="plus" aria-hidden="true" />
                </summary>
                <p>{f.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <Marquee items={['Commissions open', 'Portraits', 'Places', 'Statement pieces', 'Nationwide']} tone="accent" />

  <section class="wrap cta">
    <p class="display cta-title">Have a moment worth painting?</p>
    <div class="cta-actions">
      <a href="/contact" class="button-dark">Send an enquiry →</a>
      <a href={site.instagram} target="_blank" rel="noopener" class="link">Or message {site.instagramHandle}</a>
    </div>
  </section>
</Base>

<style>
  .page-title .headline {
    font-size: clamp(16px, 1.4vw, 20px);
  }
  .page-title :global(.long-title) {
    font-size: clamp(48px, 12.2vw, 220px);
  }
  .page-title .label {
    margin-bottom: 12px;
  }
  .lead {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    padding-bottom: clamp(80px, 10vw, 140px);
  }
  @media (min-width: 900px) {
    .lead {
      grid-template-columns: 1fr 1fr;
      gap: calc(var(--gutter) * 2);
      align-items: end;
    }
  }
  .lead-img :global(img) {
    width: 100%;
    aspect-ratio: 5 / 4;
    object-fit: cover;
  }
  .lead-text {
    display: flex;
    flex-direction: column;
    gap: 20px;
    align-items: flex-start;
    max-width: 50ch;
    font-size: 16px;
  }

  .kinds {
    padding-bottom: clamp(80px, 10vw, 140px);
  }
  .kinds ul {
    list-style: none;
    padding: 0;
    margin: 24px 0 0;
    border-top: 1px solid var(--line);
  }
  .kinds li {
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: 8px 16px;
    align-items: center;
    padding: 24px 0;
    border-bottom: 1px solid var(--line);
  }
  .kinds h2 {
    font-size: clamp(28px, 4vw, 60px);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: -0.04em;
    line-height: 0.95;
  }
  .kinds li p {
    grid-column: 2;
    max-width: 46ch;
  }
  .kinds :global(.kind-img) {
    display: none;
  }
  @media (min-width: 900px) {
    .kinds li {
      grid-template-columns: 1fr 2fr 1.4fr 140px;
      gap: var(--gutter);
    }
    .kinds li p {
      grid-column: auto;
    }
    .kinds :global(.kind-img) {
      display: block;
      width: 140px;
      aspect-ratio: 1;
      object-fit: cover;
      opacity: 0;
      transform: scale(0.9) rotate(-3deg);
      transition: opacity 0.4s, transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .kinds li:hover :global(.kind-img) {
      opacity: 1;
      transform: none;
    }
  }

  .process {
    padding-top: clamp(80px, 10vw, 140px);
    padding-bottom: clamp(80px, 10vw, 140px);
  }
  .process-title {
    font-size: clamp(48px, 6.5vw, 104px);
    max-width: 10ch;
  }
  .steps {
    list-style: none;
    padding: 0;
    margin: clamp(48px, 6vw, 96px) 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px var(--gutter);
  }
  @media (min-width: 700px) {
    .steps {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 900px) {
    .steps {
      margin-left: calc(25% + var(--gutter) / 4);
    }
  }
  .steps li {
    border-top: 1px solid var(--ink-line);
    padding-top: 16px;
    max-width: 44ch;
  }
  .steps h3 {
    font-size: clamp(20px, 1.8vw, 26px);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    margin: 12px 0 10px;
  }

  .faq {
    padding-top: clamp(80px, 10vw, 140px);
    padding-bottom: clamp(80px, 10vw, 140px);
  }
  .faq-title {
    font-size: clamp(56px, 8vw, 128px);
    margin-bottom: 32px;
  }
  .faq-list {
    border-top: 1px solid var(--line);
  }
  details {
    border-bottom: 1px solid var(--line);
  }
  summary {
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding: 22px 0;
    cursor: pointer;
    font-size: clamp(17px, 1.5vw, 21px);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover {
    color: var(--accent);
  }
  .plus {
    position: relative;
    flex: none;
    width: 14px;
    height: 14px;
  }
  .plus::before,
  .plus::after {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 100%;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .plus::after {
    transform: rotate(90deg);
  }
  details[open] .plus::after {
    transform: rotate(0deg);
  }
  details p {
    max-width: 60ch;
    padding-bottom: 24px;
    color: #4a4a47;
    font-size: 16px;
  }
  details[open] p {
    animation: fade-up 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cta {
    padding-top: clamp(80px, 10vw, 140px);
    padding-bottom: clamp(80px, 10vw, 140px);
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .cta-title {
    font-size: clamp(48px, 8vw, 132px);
    max-width: 12ch;
  }
  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 24px;
  }
</style>
