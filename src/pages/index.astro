---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Marquee from '../components/Marquee.astro';
import Contact from '../components/Contact.astro';
import Split from '../components/Split.astro';
import { site, fitWidth } from '../site';
import { steps } from '../data';
import aboutImage from '../assets/works/riders-2026-detail-1.jpg';

// Artwork crops that orbit the name. s = size factor, href/title = where the tile links.
const tileFiles = import.meta.glob<{ default: ImageMetadata }>('../assets/tiles/*.jpg', { eager: true });
const tile = (name: string) => tileFiles[`../assets/tiles/${name}.jpg`].default;
const dusk = { href: '/work/riders-at-dusk', title: 'Riders at Dusk, 2026' };
const grey = { href: '/work/riders-in-grey', title: 'Riders in Grey, 2026' };
const street = { href: '/work', title: 'Street study, detail' };
const tiles = [
  { img: 'dusk-heads', s: 1.15, ...dusk },
  { img: 'grey-texture', s: 0.85, ...grey },
  { img: 'street-roof', s: 1.1, ...street },
  { img: 'signature', s: 0.8, ...dusk },
  { img: 'grey-heads', s: 1.05, ...grey },
  { img: 'dusk-ground', s: 0.8, ...dusk },
  { img: 'street-figure', s: 0.95, ...street },
  { img: 'dusk-legs', s: 1.1, ...dusk },
  { img: 'grey-legs', s: 0.9, ...grey },
  { img: 'dusk-robe', s: 0.85, ...dusk },
];
const orbitCount = tiles.length + 1; // + the video tile

const works = (await getCollection('works', ({ data }) => data.featured)).sort((a, b) => a.data.order - b.data.order);
---

<Base image="/media/hero-poster.jpg">
  <section class="hero" data-hero data-cursor="drag">
    <div class="orbit" data-orbit>
      {
        tiles.map((t, i) => (
          <a
            href={t.href}
            class="orb"
            style={`--a:${(i / orbitCount) * 360}deg;--s:${t.s};`}
            data-title={t.title}
            data-cursor="view"
            tabindex="-1"
            aria-hidden="true"
            draggable="false"
          >
            <Image src={tile(t.img)} alt="" widths={[200, 400]} sizes="(max-width: 760px) 30vw, 13vw" loading="eager" draggable="false" />
          </a>
        ))
      }
      <a
        href="/work/riders-at-dusk"
        class="orb orb-video"
        style={`--a:${(tiles.length / orbitCount) * 360}deg;--s:1.2;`}
        data-title="Riders at Dusk, 2026 — in motion"
        data-cursor="view"
        tabindex="-1"
        aria-hidden="true"
        draggable="false"
      >
        <video src="/media/hero.mp4" poster="/media/hero-poster.jpg" autoplay muted loop playsinline preload="metadata"></video>
      </a>
    </div>

    <Split text={site.name} class="display hero-name" delay={0.15} />

    <p class="hero-line small" aria-live="off">
      <span data-hero-caption>{site.role} — vibrant stories of everyday life, {site.location}</span>
    </p>
    <a href={site.instagram} class="hero-ig small fade-in" target="_blank" rel="noopener" style="--d:0.9s">{site.instagramHandle}</a>
    <p class="hero-hint small fade-in" style="--d:1s">Drag to explore</p>
  </section>

  <Marquee items={['Impasto', 'Commissions open', 'Riders', 'City streets', 'Palette knife', 'Nationwide']} />

  <section class="wrap statement labelled">
    <p class="label">(About)</p>
    <p class="headline reveal">
      Thick, sculpted paintings of everyday life: the people, horses and busy streets that carry the beauty and resilience
      of Nigeria, built up with the palette knife until the paint stands off the canvas.
    </p>
  </section>

  <section class="wrap about">
    <div class="about-img unveil">
      <Image src={aboutImage} alt="Close-up of Riders in Grey showing the raised palette-knife texture." widths={[500, 900]} sizes="(min-width: 900px) 28vw, 100vw" />
    </div>
    <div class="about-text">
      <p>
        {site.fullName}, known as Ayotisegun, is an impasto painter whose textured layers and heavy brushwork bring emotion
        to life. His journey began in secondary school, driven by a love of art that has only grown stronger.
      </p>
      <p>
        His canvases capture the beauty, innocence and stories of people, especially children, alongside riders, markets
        and the everyday rhythm of the city.
      </p>
      <a href="/info" class="link">More about Ayotisegun →</a>
    </div>
  </section>

  <section class="wrap featured">
    <div class="featured-head small">
      <span class="label">(Featured works)</span>
      <a href="/work" class="link">All work</a>
    </div>

    {
      works.map((work, i) => (
        <a href={`/work/${work.id}`} class:list={['feature', { flip: i % 2 === 1 }]} data-cursor="view">
          <div class="panel feature-panel unveil">
            <Image src={work.data.image} alt={work.data.alt} style={`width:${fitWidth(work.data.image, 5 / 4, 0.84)}`} widths={[500, 900, 1300]} sizes="(min-width: 900px) 50vw, 100vw" />
          </div>
          <div class="feature-text">
            <p class="label">Index No. {i + 1}</p>
            <h2 class="display">{work.data.title}</h2>
            {work.data.statement && <p class="headline feature-statement">{work.data.statement}</p>}
            <span class="link">View the painting →</span>
          </div>
        </a>
      ))
    }
  </section>

  <section class="process dark wrap">
    <div class="labelled">
      <p class="label">(How it works)</p>
      <h2 class="display process-title">From a story to the canvas</h2>
    </div>
    <ol class="steps">
      {
        steps.map((s, i) => (
          <li class="reveal">
            <span class="label">{String(i + 1).padStart(2, '0')}</span>
            <h3>{s.title}</h3>
            <p class="muted">{s.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <Marquee items={['Commissions open', 'Portraits', 'Riders', 'Streets', 'Exhibitions']} tone="accent" />

  <Contact />
</Base>

<script>
  // Artworks orbit the name on a tilted ellipse: front tiles grow and pass over the letters,
  // back tiles shrink and dim behind them. Drag to spin, hover to slow down.
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (hero && !reduce) {
    const orbs = [...hero.querySelectorAll<HTMLElement>('.orb')];
    const caption = hero.querySelector<HTMLElement>('[data-hero-caption]')!;
    const defaultCaption = caption.textContent ?? '';
    const base = orbs.map((_, i) => (i / orbs.length) * Math.PI * 2);
    const root = document.documentElement;

    let angle = -0.6;
    let velocity = 0; // extra spin from intro and dragging (rad/s)
    let speed = 0.09; // resting spin (rad/s)
    let targetSpeed = 0.09;
    let intro = 0; // 0 → 1 as the orbit opens up after the preloader
    let introStart = 0;
    let mx = 0, my = 0, tmx = 0, tmy = 0;
    let visible = true;
    let last = performance.now();

    const start = () => {
      introStart = performance.now();
      velocity = 2.4;
    };
    if (root.classList.contains('ready')) start();
    else new MutationObserver((_, obs) => {
      if (root.classList.contains('ready')) { obs.disconnect(); start(); }
    }).observe(root, { attributes: true, attributeFilter: ['class'] });

    // Mouse tilt
    hero.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse') return;
      tmx = e.clientX / innerWidth - 0.5;
      tmy = e.clientY / innerHeight - 0.5;
    });

    // Hover: slow down and show the artwork title
    orbs.forEach((o) => {
      o.addEventListener('pointerenter', (e) => {
        if (e.pointerType !== 'mouse') return;
        targetSpeed = 0.015;
        caption.textContent = o.dataset.title ?? defaultCaption;
        hero.classList.add('has-focus');
        o.classList.add('focus');
      });
      o.addEventListener('pointerleave', () => {
        targetSpeed = 0.09;
        caption.textContent = defaultCaption;
        hero.classList.remove('has-focus');
        o.classList.remove('focus');
      });
    });

    // Drag to spin (horizontal), with inertia. Vertical swipes still scroll the page.
    let dragging = false, moved = 0, lastX = 0, lastT = 0;
    hero.addEventListener('pointerdown', (e) => {
      dragging = true;
      moved = 0;
      lastX = e.clientX;
      lastT = performance.now();
    });
    addEventListener('pointermove', (e) => {
      if (!dragging) return;
      const now = performance.now();
      const dx = e.clientX - lastX;
      moved += Math.abs(dx);
      const k = 3.2 / innerWidth;
      angle += dx * k;
      velocity = (dx * k * 1000) / Math.max(16, now - lastT);
      lastX = e.clientX;
      lastT = now;
      if (moved > 6) hero.classList.add('dragging');
    });
    addEventListener('pointerup', () => {
      dragging = false;
      hero.classList.remove('dragging');
    });
    hero.addEventListener('click', (e) => {
      if (moved > 6) { e.preventDefault(); e.stopPropagation(); }
    }, true);

    new IntersectionObserver(([entry]) => (visible = entry.isIntersecting)).observe(hero);

    const ease = (t: number) => 1 - Math.pow(1 - t, 4);

    const frame = (now: number) => {
      const dt = Math.min(0.05, (now - last) / 1000);
      last = now;
      if (visible && introStart) {
        intro = ease(Math.min(1, (now - introStart) / 1800));
        speed += (targetSpeed - speed) * 0.05;
        if (!dragging) {
          velocity *= Math.pow(0.12, dt); // inertia decays
          angle += (speed + velocity) * dt;
        }
        mx += (tmx - mx) * 0.05;
        my += (tmy - my) * 0.05;

        const w = innerWidth, h = hero.clientHeight;
        const mobile = w < 760;
        const scrollP = Math.min(1, Math.max(0, scrollY / h));
        const rx = (mobile ? w * 0.4 : Math.min(w * 0.41, 820)) * (0.35 + 0.65 * intro) * (1 + scrollP * 0.5);
        const ry = (mobile ? h * 0.3 : h * 0.31) * (0.35 + 0.65 * intro) * (1 + scrollP * 0.3);
        const tilt = mx * 0.18; // ellipse leans with the mouse

        orbs.forEach((o, i) => {
          const a = base[i] + angle;
          const depth = Math.sin(a); // 1 = front (bottom), -1 = back (top)
          const front = (depth + 1) / 2;
          let x = Math.cos(a) * rx;
          let y = depth * ry;
          // rotate the ellipse slightly for the tilt
          const xr = x * Math.cos(tilt) - y * Math.sin(tilt);
          const yr = x * Math.sin(tilt) + y * Math.cos(tilt) + my * 30;
          const scale = (0.5 + 0.55 * front) * (0.6 + 0.4 * intro);
          const rotY = -Math.cos(a) * 18;
          o.style.transform = `translate(-50%, -50%) translate3d(${xr.toFixed(1)}px, ${yr.toFixed(1)}px, 0) rotateY(${rotY.toFixed(1)}deg) scale(${scale.toFixed(3)})`;
          o.style.zIndex = depth > 0 ? String(30 + Math.round(front * 10)) : String(Math.round(front * 10));
          o.style.opacity = ((0.35 + 0.65 * front) * intro * (1 - scrollP * 0.9)).toFixed(3);
          o.style.filter = depth < -0.2 ? `grayscale(${((-depth - 0.2) * 0.8).toFixed(2)})` : '';
        });
      }
      requestAnimationFrame(frame);
    };
    requestAnimationFrame(frame);
  }
</script>

<style>
  .hero {
    position: relative;
    height: 100svh;
    min-height: 600px;
    overflow: hidden;
    display: grid;
    place-items: center;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
  }
  .hero.dragging {
    cursor: grabbing;
  }
  .orbit {
    position: absolute;
    inset: 0;
    perspective: 1400px;
  }
  .orb {
    --tw: clamp(110px, 12.5vw, 230px);
    position: absolute;
    left: 50%;
    top: 50%;
    width: calc(var(--tw) * var(--s));
    /* Static ring for no-JS / reduced motion; JS takes over the transform. */
    transform: translate(-50%, -50%) translate(calc(cos(var(--a)) * 40vw), calc(sin(var(--a)) * 30vh));
    will-change: transform, opacity;
    transform-style: preserve-3d;
  }
  .js:not(.ready) .orb {
    opacity: 0;
  }
  .orb :global(img),
  .orb video {
    width: 100%;
    height: auto;
    pointer-events: none;
    box-shadow: 0 24px 40px -18px rgba(0, 0, 0, 0.45);
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .orb.focus :global(img),
  .orb.focus video {
    transform: scale(1.12);
  }
  .hero.has-focus .orb:not(.focus) {
    filter: grayscale(1) !important;
  }
  .orb-video video {
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }
  .hero :global(.hero-name) {
    position: relative;
    z-index: 20;
    font-size: clamp(64px, 11.5vw, 190px);
    text-align: center;
    padding: 0 var(--gutter);
    pointer-events: none;
    white-space: nowrap;
  }
  .hero-line {
    position: absolute;
    bottom: 22px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 60;
    width: min(90%, 640px);
    text-align: center;
    text-transform: uppercase;
    font-weight: 500;
    font-size: clamp(12px, 1vw, 14px);
  }
  .hero-ig,
  .hero-hint {
    position: absolute;
    bottom: 22px;
    z-index: 60;
    font-weight: 500;
  }
  .hero-ig {
    left: var(--gutter);
  }
  .hero-hint {
    right: var(--gutter);
    color: var(--muted);
  }
  @media (max-width: 760px) {
    .orb {
      --tw: 23vw;
    }
    .hero :global(.hero-name) {
      font-size: 15.2vw;
    }
    .hero-ig,
    .hero-hint {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-hint {
      display: none;
    }
  }

  .statement {
    padding-top: clamp(80px, 11vw, 150px);
    padding-bottom: clamp(80px, 11vw, 150px);
  }
  .statement .headline {
    font-size: clamp(26px, 3.1vw, 44px);
    max-width: 30ch;
  }

  .about {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    padding-bottom: clamp(80px, 10vw, 140px);
  }
  @media (min-width: 900px) {
    .about {
      grid-template-columns: 1fr 2fr 2fr;
      gap: var(--gutter);
    }
    .about-img {
      grid-column: 2;
    }
  }
  .about-img :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .about-text {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 48ch;
    align-items: flex-start;
  }

  .featured {
    border-top: 1px solid var(--line);
    padding-top: 16px;
    padding-bottom: clamp(80px, 10vw, 140px);
  }
  .featured-head {
    display: flex;
    justify-content: space-between;
    margin-bottom: clamp(32px, 5vw, 64px);
  }
  .feature {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    margin-bottom: clamp(56px, 8vw, 120px);
  }
  @media (min-width: 900px) {
    .feature {
      grid-template-columns: 1fr 1fr;
      gap: var(--gutter);
      align-items: start;
    }
    .feature.flip .feature-panel {
      order: 2;
    }
  }
  .feature-panel {
    aspect-ratio: 5 / 4;
    padding: 0;
  }
  .feature-text {
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-items: flex-start;
  }
  .feature-text h2 {
    font-size: clamp(48px, 6.5vw, 104px);
    margin-bottom: 8px;
  }
  .feature-statement {
    font-size: clamp(15px, 1.2vw, 18px);
    max-width: 40ch;
  }
  .feature:hover .link {
    color: var(--accent);
  }

  .process {
    padding-top: clamp(80px, 10vw, 140px);
    padding-bottom: clamp(80px, 10vw, 140px);
  }
  .process-title {
    font-size: clamp(48px, 6.5vw, 104px);
    max-width: 10ch;
  }
  .steps {
    list-style: none;
    padding: 0;
    margin: clamp(48px, 6vw, 96px) 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px var(--gutter);
  }
  @media (min-width: 700px) {
    .steps {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 900px) {
    .steps {
      margin-left: calc(25% + var(--gutter) / 4);
    }
  }
  .steps li {
    border-top: 1px solid var(--ink-line);
    padding-top: 16px;
    max-width: 44ch;
  }
  .steps h3 {
    font-size: clamp(20px, 1.8vw, 26px);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    margin: 12px 0 10px;
  }
  .steps p {
    font-size: 14px;
  }
</style>
